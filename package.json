{
  "name": "@binarynoir/vitepress-reading-time-tag",
  "version": "0.1.3",
  "description": "Write [[readingTime]] in VitePress 2 Markdown and get a \"Reading time\" tip block with the page's estimated reading time, calculated at build time.",
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "markdown-it",
    "markdown-it-plugin",
    "reading-time",
    "docs",
    "documentation"
  ],
  "license": "MIT",
  "author": "BinaryNoir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binarynoir/vitepress-reading-time-tag.git"
  },
  "homepage": "https://github.com/binarynoir/vitepress-reading-time-tag#readme",
  "bugs": {
    "url": "https://github.com/binarynoir/vitepress-reading-time-tag/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "require": "./dist/vitepress.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0",
    "vitepress": "^1.0.0 || ^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1"
  }
}
